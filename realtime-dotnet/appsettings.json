{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "gateway-dotnet",
    "Audience": "gateway-dotnet-clients",
    "SecretKey": "replace-with-a-long-random-jwt-secret-key"
  },
  "RabbitMq": {
    "Exchange": "chat.exchange",
    "RoutingKey": "message.created",
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "QueueName": "chat.message.created.queue",
    "DeliveredQueueName": "chat.message.delivered.queue",
    "DeliveredRoutingKey": "message.delivered",
    "ReadQueueName": "chat.message.read.queue",
    "ReadRoutingKey": "message.read"
  },
  "Redis": {
    "Host": "localhost",
    "Port": 6379,
    "PresenceKeyPrefix": "presence",
    "PresenceTtlSeconds": 120
  },
  "Gateway": {
    "BaseUrl": "http://localhost:5001"
  }
}
